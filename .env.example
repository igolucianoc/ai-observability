# =============================================================================
# AI Observability Hub — environment example
# Copy to .env and adjust values. Never commit real secrets.
# =============================================================================

# ---- Shared ----
NODE_ENV=development

# ---- Database (PostgreSQL) ----
POSTGRES_USER=aiobs
POSTGRES_PASSWORD=aiobs
POSTGRES_DB=ai_observability
POSTGRES_PORT=5432
# Connection string used by the API (Prisma). Host "postgres" is the compose service.
DATABASE_URL=postgresql://aiobs:aiobs@postgres:5432/ai_observability?schema=public

# ---- Redis (reserved for future use: queues/BullMQ) ----
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ---- API (NestJS) ----
API_PORT=3333
# Comma-separated list of allowed origins for CORS.
API_CORS_ORIGINS=http://localhost:3000

# ---- Auth (JWT) ----
# Use long, random values in real deployments (e.g. `openssl rand -base64 32`).
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
# Token lifetimes in seconds (access: 15m, refresh: 7d).
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
# Set to true when serving over HTTPS so auth cookies are marked Secure.
COOKIE_SECURE=false

# ---- AI insights (Hugging Face Inference API) ----
# Optional. Without a token, the "explain trace" feature runs in mock mode
# (deterministic synthetic explanations). Never commit a real token.
HF_API_TOKEN=
# Default model used when the chat request does not specify one.
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Comma-separated allowlist of models offered in the chat's model picker.
HF_MODELS=meta-llama/Llama-3.1-8B-Instruct,meta-llama/Llama-3.3-70B-Instruct,deepseek-ai/DeepSeek-V3-0324,Qwen/Qwen2.5-7B-Instruct,mistralai/Mistral-7B-Instruct-v0.3
HF_TIMEOUT_MS=10000
HF_MAX_NEW_TOKENS=180

# ---- Web (Next.js) ----
WEB_PORT=3000
# Base URL the browser/web uses to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:3333
